.bh-section-header {
    -unity-font-style: bold;
    margin-top: 12px;
    margin-bottom: 3px;
    margin-left: 3px;
}

.bh-right {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.bh-device-list {
    margin-left: 3px;
    margin-right: 3px;
}

.bh-row {
    margin: 2px 0;
    padding: 2px;
    border-radius: 4px;
    /* The background alone is near the window colour in the light theme; the border keeps the row visible there. */
    background-color: var(--unity-colors-alternated_rows-background);
    border-width: 1px;
    border-color: var(--unity-colors-helpbox-border);
}

.bh-row__header {
    flex-direction: row;
    align-items: center;
    height: 22px;
    padding-right: 2px;
}

/* Fits the longest device name, "Right Glove", with a gap, so every subtitle starts in one column. */
.bh-row__foldout {
    flex-shrink: 0;
    min-width: 96px;
}

.bh-row__foldout > .unity-foldout__content {
    display: none;
}

/* The inspector's foldout toggle has a negative margin that pushes the arrow out of the row. */
.bh-row__foldout > .unity-foldout__toggle--inspector {
    margin-left: 0;
}

.bh-row__subtitle {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    /* No theme variable for secondary text; the editor dims disabled text with opacity too. */
    color: var(--unity-colors-label-text);
    opacity: 0.6;
}

.bh-row__icon {
    width: 16px;
    height: 16px;
    margin-left: 3px;
    flex-shrink: 0;
}

.bh-missing .unity-object-field-display__label {
    color: var(--unity-colors-error-text);
}

.bh-row__content {
    padding: 2px 4px 6px 16px;
    /* No theme variable fits; translucent black darkens the row in both themes. */
    background-color: rgba(0, 0, 0, 0.08);
}

.bh-icon-button {
    width: 18px;
    height: 18px;
    margin: 0 0 0 3px;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.bh-icon-button:hover {
    background-color: var(--unity-colors-toolbar_button-background-hover);
}

.bh-message {
    align-items: flex-start;
}

.bh-message__column {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 32px;
    justify-content: center;
}

.bh-message__extra {
    padding: 0 4px 0 4px;
}

.bh-buttons {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 4px;
}

.bh-buttons > Button {
    margin-left: 0;
    margin-right: 4px;
}

.bh-info__input {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.bh-info__value {
    -unity-text-align: middle-left;
    padding-left: 2px;
}

/* Sits at the end of the Scale label, where the Transform inspector has its link. */
.bh-scale-lock {
    position: absolute;
    right: 2px;
    top: 1px;
    margin: 0;
}

.bh-separator {
    height: 1px;
    margin: 10px 3px 6px 3px;
    background-color: var(--unity-colors-default-border);
}

.bh-grow {
    flex-grow: 1;
}

.bh-status {
    margin-right: 6px;
    color: var(--unity-colors-label-text);
    opacity: 0.6;
}

.bh-line {
    white-space: normal;
    margin-top: 1px;
}

.bh-line--title {
    -unity-font-style: bold;
    margin-top: 4px;
}

/* No theme variable for warning text; this amber reads in both themes. */
.bh-line--warn {
    color: rgb(214, 140, 30);
}

.bh-link {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0 2px;
    margin: 0;
    color: var(--unity-colors-link-text);
    font-size: 11px;
    cursor: link;
}
